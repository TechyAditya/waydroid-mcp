{
  "name": "waydroid-mcp",
  "version": "0.1.0",
  "description": "MCP server to launch, drive and debug Android apps in Waydroid: per-app and hidden displays, input, UI tree, logcat, crashes, Perfetto traces",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "waydroid",
    "android",
    "adb",
    "logcat",
    "perfetto"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Aditya Sethi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechyAditya/waydroid-mcp.git"
  },
  "homepage": "https://github.com/TechyAditya/waydroid-mcp#readme",
  "bugs": {
    "url": "https://github.com/TechyAditya/waydroid-mcp/issues"
  },
  "type": "module",
  "bin": {
    "waydroid-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
